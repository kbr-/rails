import Rails.RuleTextParse

/-!
`rails-texts RULES.md OUT.lean`: every numbered rule of the consolidated rules as Lean data, its
number, keywords, text and sources' codes, written to `OUT.lean` as `Rails.RuleText.entries`. It
refuses a file whose numbers aren't 1 to N in order, printing the first number out of place.
-/

open Rails.RuleTextParse

def entry (i : Item) : String :=
  let kws := ", ".intercalate (i.keywords.map Keyword.leanName)
  let srcs := ", ".intercalate (i.sources.map String.quote)
  s!"  ⟨{i.number}, [{kws}], {i.text.quote}, [{srcs}]⟩"

/-- Items in chunks of `n`: a literal of all 1403 at once exceeds the elaborator's recursion depth. -/
def chunksAux {α} (n : Nat) : Nat → List α → List (List α)
  | 0, _ | _, [] => []
  | fuel + 1, l => l.take n :: chunksAux n fuel (l.drop n)

def chunks {α} (n : Nat) (l : List α) : List (List α) := chunksAux n l.length l

def render (items : List Item) : String :=
  let parts := (chunks 100 items).zipIdx.map fun (c, k) =>
    s!"def part{k} : Array Item := #[\n" ++ ",\n".intercalate (c.map entry) ++ "]\n"
  let names := (List.range parts.length).map (s!"part{·}")
  "import Rails.RuleTextParse\n\n/-! Generated by `rails-texts` from `tasks/agents-on-rails/RULES.md`; \
  don't edit by hand. -/\n\nnamespace Rails.RuleText\nopen Rails.RuleTextParse\n\n" ++
  "\n".intercalate parts ++
  "\n/-- Each rule's number, its keywords in order, its text without its sources, and their codes. -/\n\
  def entries : Array Item := " ++ " ++ ".intercalate names ++ "\n\nend Rails.RuleText\n"

def main (args : List String) : IO UInt32 := do
  match args with
  | [src, out] =>
    let items := items (← IO.FS.lines src).toList
    let numbers := items.map (·.number)
    let expected := List.range' 1 items.length
    if numbers != expected then
      let bad := (numbers.zip expected).find? (fun (a, b) => a != b)
      IO.eprintln s!"rails-texts: the rules aren't numbered 1 to {items.length} in order; first out of place: {bad}"
      return 1
    IO.FS.writeFile out (render items)
    let noKeyword := items.filter (·.keywords.isEmpty)
    IO.println s!"{items.length} rules written to {out}; {noKeyword.length} with no keyword \
      {(noKeyword.map (·.number)).take 20}; {(items.filter (·.sources.isEmpty)).length} with no sources"
    return 0
  | _ =>
    IO.eprintln "usage: rails-texts RULES.md OUT.lean"
    return 2
